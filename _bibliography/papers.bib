



@article{liu2026prophet,
  title   = {Information-Constrained Prophet Inequalities via Kolmogorov-Wiener Prediction Theory},
  author  = {Liu, Ziran},
  year    = {2026},
  month   = {March},
  journal = {Preprint},
  abstract = {This paper studies finite-horizon sequential selection and pricing under compressed past information. The central thesis is that the relevant online state is a canonical predictive state: a structured summary of the past that preserves the continuation values driving optimal decisions. We prove a general compression-to-decision principle, showing that the loss relative to the full-information online optimum is bounded by the cumulative distortion of continuation values. In a Gaussian observation model using Hardy-space spectral factorization, we derive explicit prophet and pricing guarantees. For rational causally invertible spectral factors, we prove exact finite-dimensional realizability, where the compressed-state policy coincides with the full-information optimum.},
  keywords = {prophet inequality, posted pricing, optimal stopping, predictive state, Hardy space, spectral factorization, Gaussian process, state compression, online decision-making},
  note     = {MSC 2020: 60G40, 60G25, 62M20},
  pdf     = {Prophet_Inequalities_via_Predictive_State_Compression.pdf}
}



@article{liu2026gch,
  title   = {Gaussian Chaos Noise: Variational Design of Structured Noise for Reliable Deep Learning},
  author  = {Liu, Ziran},
  journal = {Preprint},
  year    = {2026},
  institution = {Shanghai Institute for Mathematics and Interdisciplinary Sciences (SIMIS)},
  address = {Shanghai, China},
  abstract = {We study internal noise design through two linked questions: what correlation geometry should training-time noise have, and is the implemented perturbation actually compatible with the representations deep networks use? We introduce Variational Kernel Design (VKD), a framework where noise is derived from learning-motivated constraints. This yields Gaussian Chaos Noise (GCH), which induces a finite, margin-aware deformation of relative geometry. Empirically, GCH reduces ECE by 33-46% on ImageNet while maintaining competitive accuracy and improving calibration under distribution shift.},
  keywords = {Noise Injection, Noise Design, Maximum Entropy, Calibration, Distribution Shift, Robustness, Gaussian Multiplicative Chaos},
  url      = {zliu@simis.cn}
}





